# Modèle des variables de l'infrastructure locale.
# Copier en infra/.env (non versionné) et adapter si besoin.

# Postgres
POSTGRES_USER=jobcompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobcompass
POSTGRES_PORT=5432

# Stockage objet S3 (RustFS)
S3_ACCESS_KEY=jobcompass
S3_SECRET_KEY=change-me-too
S3_BUCKET=jobcompass-raw
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
