# Modèle des réglages communs à l'extraction de tous les sites.
# Copier en extraction/.env (non versionné) et adapter si besoin ; une ligne
# absente garde sa valeur par défaut (extraction/src/extraction/settings.py).
# Les réglages propres à un site restent dans son site.toml.

# Identifie JobCompass auprès des sites : y mettre un contact (mail ou URL)
# avant toute collecte complète.
EXTRACTION_USER_AGENT=JobCompass/0.1 (job market research)

# Délai d'attente d'une réponse, en secondes
EXTRACTION_HTTP_TIMEOUT=30

# Échecs de téléchargement d'une fiche avant de la mettre de côté
EXTRACTION_MAX_FAILURES=3

# DEBUG, INFO, WARNING ou ERROR
EXTRACTION_LOG_LEVEL=INFO
