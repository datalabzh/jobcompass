{
  "additionalProperties": false,
  "description": "A job as seen on a portal result page.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "description": "Id of the extraction run (UUID)",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "url": {
      "description": "URL of the job detail page",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "seen_at": {
      "description": "Time the result page was read",
      "format": "date-time",
      "title": "Seen At",
      "type": "string"
    },
    "listing_params": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Context of the run, e.g. the category",
      "title": "Listing Params",
      "type": "object"
    },
    "card": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw JSON of the job as given by the result page",
      "title": "Card"
    }
  },
  "required": [
    "run_id",
    "source",
    "url",
    "seen_at"
  ],
  "title": "JobInfo",
  "type": "object"
}
