{
  "$defs": {
    "DiscoveryMethod": {
      "description": "How an offer URL was discovered on a portal.",
      "enum": [
        "listing",
        "sitemap",
        "new_offers",
        "keyword"
      ],
      "title": "DiscoveryMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An offer seen on a portal result page, not yet fetched.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "description": "Id of the discovery run (UUID)",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "url": {
      "description": "Normalized offer URL",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "discovered_at": {
      "description": "Time the page was read",
      "format": "date-time",
      "title": "Discovered At",
      "type": "string"
    },
    "discovery_method": {
      "$ref": "#/$defs/DiscoveryMethod"
    },
    "discovery_params": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Parameters of the discovery, e.g. {'category': '702'}",
      "title": "Discovery Params",
      "type": "object"
    },
    "listing_payload": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw JSON of the offer as given by the result page",
      "title": "Listing Payload"
    }
  },
  "required": [
    "snapshot_id",
    "source",
    "url",
    "discovered_at",
    "discovery_method"
  ],
  "title": "DiscoveredOffer",
  "type": "object"
}
