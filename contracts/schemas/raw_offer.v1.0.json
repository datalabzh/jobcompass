{
  "additionalProperties": false,
  "description": "Manifest record of one successfully fetched offer content.\n\nThe content itself is stored unchanged in object storage, addressed by\n`raw_hash`. The storage location is derived from the hash by the storage\nadapter and is deliberately not part of the contract.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "url": {
      "description": "Normalized offer URL",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "raw_hash": {
      "description": "SHA-256 of the uncompressed content",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Hash",
      "type": "string"
    },
    "content_type": {
      "description": "e.g. 'text/html', 'application/json'",
      "title": "Content Type",
      "type": "string"
    },
    "fetched_at": {
      "description": "Fetch time (timezone-aware)",
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "http_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Http Status",
      "type": "integer"
    },
    "scraper_version": {
      "description": "Version of the fetcher that produced it",
      "title": "Scraper Version",
      "type": "string"
    },
    "source_lastmod": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Last modification date announced by the portal",
      "title": "Source Lastmod"
    }
  },
  "required": [
    "source",
    "url",
    "raw_hash",
    "content_type",
    "fetched_at",
    "http_status",
    "scraper_version"
  ],
  "title": "RawOffer",
  "type": "object"
}
