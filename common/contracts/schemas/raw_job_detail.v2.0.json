{
  "$defs": {
    "PayloadFormat": {
      "description": "What the payload of a job detail page holds.",
      "enum": [
        "json_ld",
        "paragraphs"
      ],
      "title": "PayloadFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One job detail page downloaded with success, with its raw data block.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "is_test": {
      "description": "True if written by a test run (limited)",
      "title": "Is Test",
      "type": "boolean"
    },
    "url": {
      "description": "URL of the job detail page",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "raw_hash": {
      "description": "SHA-256 of the uncompressed content",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Hash",
      "type": "string"
    },
    "content_type": {
      "description": "Content-Type of the answer",
      "title": "Content Type",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "http_status": {
      "maximum": 299,
      "minimum": 200,
      "title": "Http Status",
      "type": "integer"
    },
    "scraper": {
      "description": "Name of the scraper, e.g. 'jobup_scraper'",
      "title": "Scraper",
      "type": "string"
    },
    "scraper_version": {
      "description": "Version of the code that fetched it",
      "title": "Scraper Version",
      "type": "string"
    },
    "payload_format": {
      "$ref": "#/$defs/PayloadFormat"
    },
    "payload": {
      "description": "Raw data block of the page, as JSON text",
      "title": "Payload",
      "type": "string"
    }
  },
  "required": [
    "source",
    "is_test",
    "url",
    "raw_hash",
    "content_type",
    "fetched_at",
    "http_status",
    "scraper",
    "scraper_version",
    "payload_format",
    "payload"
  ],
  "title": "RawJobDetail",
  "type": "object"
}
