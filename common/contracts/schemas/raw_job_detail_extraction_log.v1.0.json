{
  "additionalProperties": false,
  "description": "One failed download of a job detail page.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "is_test": {
      "description": "True if written by a test run (limited)",
      "title": "Is Test",
      "type": "boolean"
    },
    "url": {
      "description": "URL of the job detail page",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "attempted_at": {
      "format": "date-time",
      "title": "Attempted At",
      "type": "string"
    },
    "error": {
      "description": "Short reason of the failure",
      "title": "Error",
      "type": "string"
    }
  },
  "required": [
    "source",
    "is_test",
    "url",
    "attempted_at",
    "error"
  ],
  "title": "RawJobDetailExtractionLog",
  "type": "object"
}
