{
  "$defs": {
    "RunStatus": {
      "description": "Outcome of one run of an extraction step.",
      "enum": [
        "completed",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Log of one extract_job_infos run.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "description": "Id of the extraction run (UUID)",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "is_test": {
      "description": "True if written by a test run (limited)",
      "title": "Is Test",
      "type": "boolean"
    },
    "listing_params": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Listing Params",
      "type": "object"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error that stopped the run",
      "title": "Error"
    },
    "announced_total": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Total of jobs announced by the portal",
      "title": "Announced Total"
    },
    "pages_read": {
      "minimum": 0,
      "title": "Pages Read",
      "type": "integer"
    },
    "jobs_seen": {
      "description": "Records written, duplicates included",
      "minimum": 0,
      "title": "Jobs Seen",
      "type": "integer"
    },
    "distinct_urls": {
      "minimum": 0,
      "title": "Distinct Urls",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "source",
    "is_test",
    "started_at",
    "finished_at",
    "status",
    "pages_read",
    "jobs_seen",
    "distinct_urls"
  ],
  "title": "RawJobInfoExtractionLog",
  "type": "object"
}
