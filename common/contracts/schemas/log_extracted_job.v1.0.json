{
  "additionalProperties": false,
  "description": "One failed parsing of a job detail page.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Portal slug, e.g. 'jobup'",
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    },
    "is_test": {
      "description": "True if written by a test run (limited)",
      "title": "Is Test",
      "type": "boolean"
    },
    "url": {
      "description": "URL of the job detail page",
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "raw_hash": {
      "description": "SHA-256 of the uncompressed content",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Hash",
      "type": "string"
    },
    "parser": {
      "description": "Name of the parser, e.g. 'jobup_jsonld'",
      "title": "Parser",
      "type": "string"
    },
    "parser_version": {
      "description": "Version of the parser",
      "title": "Parser Version",
      "type": "string"
    },
    "attempted_at": {
      "format": "date-time",
      "title": "Attempted At",
      "type": "string"
    },
    "error": {
      "description": "Short reason of the failure",
      "title": "Error",
      "type": "string"
    }
  },
  "required": [
    "source",
    "is_test",
    "url",
    "raw_hash",
    "parser",
    "parser_version",
    "attempted_at",
    "error"
  ],
  "title": "LogExtractedJob",
  "type": "object"
}
