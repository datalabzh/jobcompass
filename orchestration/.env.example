# Modèle des réglages de l'orchestration, propres à chaque machine.
# Copier en orchestration/.env (non versionné) et adapter si besoin.
# Une variable donnée à la commande l'emporte sur ce fichier :
#   PIPELINE_MODE=test ./orchestration/run_pipeline.sh

# test : passages limités, base jobcompass_dev, dbt --target dev (défaut, sécurité)
# full : tout le site, base de production jobcompass, dbt --target real
PIPELINE_MODE=test
